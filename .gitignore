# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/

# Secrets / local
.env
*.log
.DS_Store

# Probe step: encoding cache and probe weight arrays (regenerable; manifest/json are tracked)
.cache/*
!.cache/freetext/
.cache/freetext/*
# LLM-generated free-text note banks: not reproducible (a rerun yields different text), so they are tracked
!.cache/freetext/bank.json
!.cache/freetext/bank_hard.json
artifacts/probes/**/*.npz

# Grader step: hidden grids, texts and reference/oracle ids (regenerable; hold the answers)
artifacts/grader/

# Image build inputs (regenerable): HF weights copy and the pre-built episode bank
hf/

# Rollout collection: raw per-container files hold episode answers; only public summaries are tracked
results/rollouts/*/*/
results/rollouts/*/summary.jsonl
results/rollouts/*/launch*.log
results/rollouts/*/launcher.out
results/private_1012/

# Black-box study (Nov 2026): per-probe detail that names cues, and large raw request/response bytes
results/private_1112/
results/blackbox_1112/**/raw_private/
