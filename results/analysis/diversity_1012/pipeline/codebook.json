{
 "codebook": {
  "D1_hypotheses": [
   {
    "code": "H_READ",
    "definition": "Properties hand-listed from reading notes, screened by per-label prevalence/cross-tabs or agreement scores (no strict perfect-alignment filter)"
   },
   {
    "code": "H_ALIGN",
    "definition": "Regex detectors filtered to those perfectly (0/1) aligned with label in a probe's samples; that aligned set is the candidate list"
   },
   {
    "code": "H_REG",
    "definition": "Fixed property list nominated/ranked by a joint corpus regression with topic controls, projected through the probe gradient"
   },
   {
    "code": "H_LATENT",
    "definition": "Hypotheses derived from latents (top-activating examples of gap-contributing latents, polarity signatures)"
   }
  ],
  "D2_counterfactuals": [
   {
    "code": "CF_GEN_OAT",
    "definition": "From-scratch template generator, one property toggled at a time on fixed content (minimal pairs)"
   },
   {
    "code": "CF_GEN_FACT",
    "definition": "From-scratch generator with randomized/factorial/fold-over independent property assignment"
   },
   {
    "code": "CF_RERENDER",
    "definition": "Parser/editor that re-renders real sample notes with randomized or factorial property settings"
   },
   {
    "code": "CF_EDIT_REAL",
    "definition": "Programmatic single-property toggles/edits applied to real notes, no randomized design"
   },
   {
    "code": "CF_TOPICSWAP_CORPUS",
    "definition": "Corpus notes programmatically rewritten into each probe's topics, then toggles on that set"
   },
   {
    "code": "CF_HAND",
    "definition": "Hand-written or hand-edited individual notes only; no programmatic text set"
   }
  ],
  "D3_effect_estimate": [
   {
    "code": "E_PAIR",
    "definition": "Proxy (dF.g) paired difference of toggled vs base text, normalized by a topic effect"
   },
   {
    "code": "E_OLS_DESIGN",
    "definition": "OLS of proxy logit/latents on topic + properties over a generated or re-rendered design"
   },
   {
    "code": "E_OLS_CORPUS",
    "definition": "Regression (or mean contrast) over natural/topic-swapped corpus notes with topic controls, projected through g"
   },
   {
    "code": "E_CELL",
    "definition": "Label-/cell-/group-mean latent differences across sample sets times g, latents assigned by pattern"
   },
   {
    "code": "E_TRUE",
    "definition": "True-logit deltas on edited notes are the decision quantity; proxy only for screening"
   }
  ],
  "D4_probe_query_allocation": [
   {
    "code": "Q_2X2",
    "definition": "Crossed topic x property (or 2^(3-1)) 4-text designs on two probes"
   },
   {
    "code": "Q_CUED_PAIRS",
    "definition": "Base/edit single-property pairs only on suspected-cue probes; at least one probe skipped"
   },
   {
    "code": "Q_SPREAD_SINGLE",
    "definition": "Single-property edits spread over all four probes as true-logit screening"
   },
   {
    "code": "Q_TOPIC_REF",
    "definition": "Cue edit paired with a topic-swap reference on the same/similar note per probe, to scale cue vs topic"
   },
   {
    "code": "Q_BUNDLE",
    "definition": "Whole-bundle / all-but-cue flips are a main element (does style matter at all), with single follow-ups"
   },
   {
    "code": "Q_FOCUS_ONE",
    "definition": "Majority (>=5) of queries on one probe to disentangle its candidates"
   }
  ],
  "D5_null_rule": [
   {
    "code": "N_THRESH",
    "definition": "Explicit numeric cutoff on cue/topic dependence ratio (~0.15-0.2)"
   },
   {
    "code": "N_JUDGE",
    "definition": "Implicit: all proxy/regression property effects small relative to topic, by inspection"
   },
   {
    "code": "N_TRUE_SINGLE",
    "definition": "Single-property true-logit edits small or inconsistent"
   },
   {
    "code": "N_BUNDLE_TRUE",
    "definition": "Flipping the whole style bundle barely moves the true logit (vs topic swap / label gap)"
   },
   {
    "code": "N_TOPIC_GAP",
    "definition": "Topic swap alone reproduces the full label gap (non-topic share ~0)"
   },
   {
    "code": "N_DEFAULT",
    "definition": "Default/untested: probe never singled out is left none"
   }
  ],
  "D6_confound_disentangling": [
   {
    "code": "X_OAT",
    "definition": "Flip each property alone on fixed content, normalized by topic"
   },
   {
    "code": "X_RANDOM",
    "definition": "Independent randomized/factorial/orthogonal assignment plus joint regression"
   },
   {
    "code": "X_CORPUS_REG",
    "definition": "Joint regression on corpus (or topic-swapped corpus) where properties vary independently, topic dummies"
   },
   {
    "code": "X_CROSSPROBE",
    "definition": "Different sign/alignment patterns across the four sample sets plus token content to split properties"
   },
   {
    "code": "X_SUBTRACT",
    "definition": "Keep-cue/flip-rest or style-matched topic contrast; topic isolated by subtracting property contributions"
   }
  ],
  "D7_regex": [
   {
    "code": "R_BA_ALL",
    "definition": "Validated by balanced accuracy/agreement vs a detector/parser over corpus (+samples/generated)"
   },
   {
    "code": "R_SAMPLE",
    "definition": "Validated only on sample notes (label agreement, match counts, BA on samples)"
   },
   {
    "code": "R_INVENTORY",
    "definition": "Written from enumerated phrase/form tallies, no formal accuracy metric"
   },
   {
    "code": "R_NOCHECK",
    "definition": "Written from definitions/templates with no data check (compile/length at most)"
   }
  ],
  "D8_latent_selection": [
   {
    "code": "L_TOPK",
    "definition": "Top-16 by cue contribution (incl. averaged estimates/stability selection), topic only eyeballed"
   },
   {
    "code": "L_TOPK_FILTER",
    "definition": "Rank by sign-aligned cue contribution, exclude latents above a per-latent or cumulative topic cap, take 16"
   },
   {
    "code": "L_TOPK_PENALTY",
    "definition": "Rank by cue contribution minus lambda x topic contribution (or blended score), take 16"
   },
   {
    "code": "L_GREEDY",
    "definition": "Greedy/swap optimization of a removal objective (cue/topic ratio, max-min over cues) under a topic-kept floor"
   },
   {
    "code": "L_PATTERN",
    "definition": "Latents chosen by pattern/signature match (8-cell, cross-probe polarity, template cosine) plus contribution"
   },
   {
    "code": "L_HAND",
    "definition": "Final set hand-picked by reading tokens/examples after a ranking/purity filter"
   }
  ],
  "D9_verification": [
   {
    "code": "V_ABL_SAMPLE",
    "definition": "Ablation (probe_scores or local mean-ablation) scored on sample notes vs prediction/separation"
   },
   {
    "code": "V_HOLDOUT",
    "definition": "Split-half, cross-validation, or held-out design to check selection/removal stability"
   },
   {
    "code": "V_OFFLINE",
    "definition": "Offline estimate of cue removed / topic kept from proxy contributions only"
   },
   {
    "code": "V_TRUE_QUERY",
    "definition": "True-logit edits after selection"
   },
   {
    "code": "V_INSPECT",
    "definition": "Only token/example inspection and format checks"
   }
  ]
 },
 "notes": {
  "pq": "Texts per session (sum 8). Base texts are counted with the contrast they anchor; 2x2 topic x cue sets count as single; null = texts explicitly spent to confirm/bound a none answer; other = 2-3 property partial edits or baselines.",
  "pq_timing": "before/after/mixed relative to the D8 latent-selection decision step (inferred from steps)",
  "secondary": "second label where a session clearly combined two methods; primary is the main field"
 },
